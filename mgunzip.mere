// mgunzip <file.gz> -> writes <file.gz>.out
// The CLI over inflate.mere: read, check the magic, inflate, verify, write.
import "./inflate.mere";

let main = fn () ->
  match args () with
  | Nil -> print "usage: mgunzip <file.gz>"
  | Cons (path, _) ->
    // read_bytes, not read_file_bytes: the latter costs eight bytes per byte,
    // and a gzip member is the one thing here whose size is not ours to choose.
    let data = bytebuf_of_bytes (read_bytes path) in
    if is_gzip data then
      // Straight to the file. The two numbers the trailer carries were counted
      // as the bytes went past, so nothing is kept in order to check them.
      let (n, crc) = gunzip_to data (path ++ ".out") in
      print (str_of_int (bytebuf_len data) ++ " -> " ++ str_of_int n
             ++ " bytes, crc " ++ (if gzip_trailer_ok data n crc then "OK" else "MISMATCH"))
    else print "not a gzip file";
main ()
