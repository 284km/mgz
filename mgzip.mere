// mgzip <file> -> writes <file>.mgz
// The CLI over deflate.mere: read, compress, write.
import "./deflate.mere";

let main = fn () ->
  match args () with
  | Nil -> print "usage: mgzip <file>"
  | Cons (path, _) ->
    let data = read_file_bytes path in
    let gz = deflate_gzip data in
    let _ = write_file_bytes (path ++ ".mgz") gz in
    print (str_of_int (vec_len data) ++ " -> " ++ str_of_int (vec_len gz)
           ++ " bytes (dynamic) " ++ path ++ ".mgz");
main ()
